# --- Supabase (Project Settings → API) ---------------------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" public key (or the newer "publishable" key). Safe for the browser:
# every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site ---------------------------------------------------------------------
# Public URL of the deployment (used for auth email links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Strava (optional) ---------------------------------------------------------
# From https://www.strava.com/settings/api. Set "Authorization Callback Domain"
# there to your site's domain (e.g. your-app.vercel.app, or localhost).
# Server-only: never prefix these with NEXT_PUBLIC_.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# NOTE: LOCK IN never needs the Supabase service-role key. Do not add it here or
# to Vercel. Account deletion runs through a locked-down database function.

# --- Tests only (optional) ----------------------------------------------------
# Defaults to the local `supabase start` stack.
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_ANON_KEY=
